---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import AffiliateBox from '../../components/AffiliateBox.astro';
import { languages, text, type Lang } from '../../i18n';
import { legal, operatorReady } from '../../legal';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const paths = posts.map(post => {
    const [lang, slug] = post.id.split('/');
    if (lang !== post.data.lang || !slug) throw new Error(`Invalid language or slug for ${post.id}`);
    return { params: { lang: post.data.lang, slug }, props: { post } };
  });
  return [
    ...paths,
    ...languages.flatMap(lang => Object.entries(legal[lang]).map(([slug, page]) => ({
      params: { lang, slug }, props: { page },
    }))),
  ];
}

const lang = Astro.params.lang as Lang;
const t = text[lang];
const { post, page } = Astro.props;
const rendered = post ? await render(post) : undefined;
const Content = rendered?.Content;
const data = post?.data;
const slug = Astro.params.slug;

const coverImage = data?.videoId
  ? `https://i.ytimg.com/vi/${data.videoId}/hqdefault.jpg`
  : data?.image;

const alternates = data
  ? Object.fromEntries(
      (await getCollection('posts'))
        .filter(entry => entry.id.endsWith(`/${slug}`))
        .map(entry => [entry.data.lang, `/${entry.id}/`])
    )
  : Object.fromEntries(
      languages
        .filter(code => slug in legal[code])
        .map(code => [code, `/${code}/${slug}/`])
    );

const url = new URL(Astro.url.pathname, Astro.site).href;
const readTime = post?.body ? Math.max(1, Math.ceil(post.body.split(/\s+/).length / 200)) : 3;

const ui = {
  de: { back: 'Alle Guides', readMin: 'Min. Lesezeit', video: 'Video-Guide', quickFaq: 'Häufige Fragen', by: 'Von', role: 'Redaktion' },
  en: { back: 'All Guides', readMin: 'min read', video: 'Video Guide', quickFaq: 'Quick FAQ', by: 'By', role: 'Editor' },
  pl: { back: 'Wszystkie poradniki', readMin: 'min czytania', video: 'Wideo poradnik', quickFaq: 'Szybkie FAQ', by: 'Autor:', role: 'Redakcja' },
}[lang];

const categoryColors = {
  game: 'bg-lime-400 text-black',
  hardware: 'bg-cyan-400 text-black',
  deals: 'bg-amber-400 text-black',
};

const schema = data && {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: data.title,
      description: data.description,
      ...(coverImage ? { image: [coverImage] } : {}),
      datePublished: data.pubDate.toISOString(),
      inLanguage: lang,
      mainEntityOfPage: url,
      author: { '@type': 'Person', name: 'Adrian' },
      publisher: { '@type': 'Organization', name: 'RespawnPing' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: data.faq.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<Base
  {lang}
  title={`${data?.title ?? page?.title} | RespawnPing`}
  description={data?.description ?? page?.title ?? ''}
  article={!!data}
  {alternates}
  noindex={!data && !operatorReady}
>
  {schema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />}
  {coverImage && <meta slot="head" property="og:image" content={coverImage} />}

  {data && Content ? (
    <article class="mx-auto max-w-4xl">
      <div class="mb-6">
        <a
          href={`/${lang}/`}
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-zinc-400 transition-colors hover:text-lime-400"
        >
          &larr; {ui.back}
        </a>
      </div>

      <AdSlot {lang} placement="top" />

      {/* Header */}
      <header class="mt-6 mb-8 border-b border-zinc-800 pb-6">
        <div class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-wider">
          <span class={`px-2 py-0.5 text-[10px] font-black ${categoryColors[data.category]}`}>
            {t[data.category]}
          </span>
          <time class="text-zinc-400" datetime={data.pubDate.toISOString()}>
            {data.pubDate.toLocaleDateString(lang, { dateStyle: 'long', timeZone: 'UTC' })}
          </time>
          <span class="text-zinc-600">&bull;</span>
          <span class="text-lime-400">{readTime} {ui.readMin}</span>
        </div>

        <h1 class="mt-4 text-3xl font-black tracking-tight text-white leading-tight sm:text-5xl">
          {data.title}
        </h1>
        <p class="mt-4 text-base text-zinc-300 leading-relaxed sm:text-lg">
          {data.description}
        </p>

        {/* Pasek autora */}
        <div class="mt-5 flex items-center gap-2.5 border-t border-zinc-800/70 pt-4 text-xs text-zinc-400">
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-lime-400/15 font-black text-lime-400 ring-1 ring-lime-400/30">
            A
          </span>
          <div class="leading-tight">
            <span class="font-bold text-zinc-200">{ui.by} Adrian</span>
            <span class="ml-1.5 text-[11px] text-zinc-500">({ui.role})</span>
          </div>
        </div>

        {data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {data.tags.map(tag => (
              <span class="text-xs font-semibold text-zinc-500">#{tag}</span>
            ))}
          </div>
        )}
      </header>

      {/* Embedded YouTube Video OR Cover Image */}
      {data.videoId ? (
        <section class="mb-8 overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900/70 p-3 sm:p-4">
          <div class="mb-2.5 flex items-center gap-2 text-xs font-black uppercase tracking-wider text-lime-400">
            <span class="h-2 w-2 rounded-full bg-lime-400 animate-pulse"></span>
            {ui.video}
          </div>
          <div class="aspect-video w-full overflow-hidden rounded-lg bg-black">
            <iframe
              class="h-full w-full"
              src={`https://www.youtube-nocookie.com/embed/${data.videoId}`}
              title={data.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </section>
      ) : (
        coverImage && (
          <figure class="mb-8 overflow-hidden rounded-xl bg-zinc-900">
            <img
              src={coverImage}
              alt={data.title}
              class="aspect-video w-full object-cover object-center"
            />
          </figure>
        )
      )}

      {/* Main Article Body */}
      <div class="copy">
        <Content />
      </div>

      <div class="my-8">
        <AdSlot {lang} placement="in-article" />
      </div>

      <AffiliateBox {lang} category={data.category} query={data.affiliateQuery} />

      {/* Modern Accordion FAQ */}
      <section class="mt-10 border-t border-zinc-800 pt-8">
        <h2 class="mb-5 text-2xl font-black uppercase tracking-tight text-white">{t.faq ?? ui.quickFaq}</h2>
        <div class="space-y-3">
          {data.faq.map(({ q, a }, index) => (
            <details
              open={index === 0}
              class="group rounded-xl border border-zinc-800 bg-zinc-900/50 transition-colors open:border-lime-400/50"
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 font-bold text-white select-none group-hover:text-lime-400">
                <span>{q}</span>
                <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-zinc-800 text-xs font-black text-lime-400 transition-transform group-open:rotate-45">
                  +
                </span>
              </summary>
              <div class="border-t border-zinc-800/70 px-4 pb-4 pt-3 text-sm leading-relaxed text-zinc-300">
                {a}
              </div>
            </details>
          ))}
        </div>
      </section>

      <AdSlot {lang} placement="sticky-mobile" />
    </article>
  ) : (
    page && (
      <article class="copy mx-auto max-w-3xl">
        <h1 class="text-4xl font-black text-white">{page.title}</h1>
        {page.paragraphs.map(paragraph => (
          <p class="whitespace-pre-line text-zinc-300">{paragraph}</p>
        ))}
      </article>
    )
  )}
</Base>
