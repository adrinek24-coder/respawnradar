---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { languages, text } from '../../i18n';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = text[lang];
const posts = (await getCollection('posts', ({ data }) => data.lang === lang))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const alternates = { de: '/de/', en: '/en/', pl: '/pl/' };

const [featured, ...restPosts] = posts;

const ui = {
  de: { badge: 'Live Gaming Intel', featured: 'TOP GUIDE', read: 'Lesen', all: 'Alle' },
  en: { badge: 'Live Gaming Intel', featured: 'FEATURED GUIDE', read: 'Read', all: 'All' },
  pl: { badge: 'Radar Poradników', featured: 'GORĄCY PORADNIK', read: 'Czytaj', all: 'Wszystkie' },
}[lang];

const categoryColors = {
  game: 'from-lime-400 to-emerald-500 text-slate-950',
  hardware: 'from-cyan-400 to-blue-500 text-slate-950',
  deals: 'from-amber-400 to-orange-500 text-slate-950',
};
---

<Base {lang} title={`RespawnPing | ${t.headline}`} description={t.intro} {alternates}>
  {/* Hero Banner */}
  <section class="relative overflow-hidden rounded-3xl border border-slate-800/80 bg-slate-950 px-6 py-12 sm:px-10 sm:py-16">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_85%_40%,rgba(132,204,22,0.18),transparent_55%)]"></div>
    <div class="absolute right-0 top-0 hidden h-full w-1/2 opacity-20 pointer-events-none md:block" style="background-image: radial-gradient(circle, #84cc16 1px, transparent 1px); background-size: 22px 22px;"></div>
    <div class="relative z-10 max-w-2xl">
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-lime-500/25 bg-lime-500/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-lime-400">
        <span class="h-2 w-2 rounded-full bg-lime-400 animate-pulse"></span>
        {ui.badge}
      </div>
      <h1 class="text-4xl font-black tracking-tight text-white sm:text-6xl">{t.headline}</h1>
      <p class="mt-4 text-base text-slate-300 sm:text-lg">{t.intro}</p>
    </div>
  </section>

  <div class="my-6">
    <AdSlot {lang} placement="top" />
  </div>

  {/* Featured (Latest) Post */}
  {featured && (
    <section class="mt-8">
      <article
        data-category={featured.data.category}
        class="post-card group relative grid overflow-hidden rounded-3xl border border-slate-800/90 bg-slate-900/70 transition-all duration-300 hover:border-lime-400/40 hover:shadow-[0_12px_35px_-12px_rgba(0,0,0,0.8),0_0_25px_rgba(132,204,22,0.08)] lg:grid-cols-2"
      >
        <div class="relative aspect-video w-full overflow-hidden bg-slate-950 lg:aspect-auto lg:min-h-[320px]">
          {featured.data.image ? (
            <img
              src={featured.data.image}
              alt={featured.data.title}
              class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
            />
          ) : (
            <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-slate-900 via-slate-950 to-emerald-950/80">
              <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle, #84cc16 1px, transparent 1px); background-size: 16px 16px;"></div>
              <svg class="h-16 w-16 text-lime-400/35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="4" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" />
              </svg>
            </div>
          )}
          <span class="absolute left-4 top-4 z-10 rounded-md bg-lime-400 px-3 py-1 text-[11px] font-black uppercase tracking-wider text-slate-950 shadow-lg">
            {ui.featured}
          </span>
        </div>

        <div class="flex flex-col justify-center p-6 sm:p-8">
          <div class="flex items-center gap-3 text-xs font-semibold">
            <span class={`rounded-md bg-gradient-to-r px-2.5 py-0.5 text-[10px] font-black uppercase tracking-wider ${categoryColors[featured.data.category]}`}>
              {t[featured.data.category]}
            </span>
            <time class="text-slate-400" datetime={featured.data.pubDate.toISOString()}>
              {featured.data.pubDate.toLocaleDateString(lang, { dateStyle: 'medium', timeZone: 'UTC' })}
            </time>
          </div>
          <h2 class="mt-4 text-2xl font-black leading-tight text-white transition-colors group-hover:text-lime-400 sm:text-3xl">
            <a href={`/${featured.id}/`} class="after:absolute after:inset-0">
              {featured.data.title}
            </a>
          </h2>
          <p class="mt-3 text-slate-300 line-clamp-3">{featured.data.description}</p>
          <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-slate-800/70 pt-4">
            <div class="flex flex-wrap gap-1.5">
              {featured.data.tags.slice(0, 3).map(tag => (
                <span class="rounded bg-slate-800/90 px-2 py-0.5 text-[11px] font-medium text-slate-400">#{tag}</span>
              ))}
            </div>
            <span class="inline-flex items-center gap-1 text-sm font-bold text-lime-400">
              {ui.read} &rarr;
            </span>
          </div>
        </div>
      </article>
    </section>
  )}

  {/* Latest Articles Grid + Category Filter */}
  <section class="mt-12">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4 border-b border-slate-800 pb-4">
      <h2 class="text-2xl font-black tracking-tight text-white">{t.latest}</h2>
      <div class="flex flex-wrap gap-2" id="category-filters">
        <button data-filter="all" class="filter-btn rounded-lg bg-lime-400 px-3 py-1.5 text-xs font-bold text-slate-950 transition-colors cursor-pointer">
          {ui.all}
        </button>
        {(['game', 'hardware', 'deals'] as const).map(cat => (
          <button data-filter={cat} class="filter-btn rounded-lg border border-slate-800 bg-slate-900 px-3 py-1.5 text-xs font-bold text-slate-300 transition-colors hover:border-lime-400/50 hover:text-white cursor-pointer">
            {t[cat]}
          </button>
        ))}
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {restPosts.map(({ id, data }) => (
        <article
          data-category={data.category}
          class="post-card group relative flex flex-col overflow-hidden rounded-2xl border border-slate-800/90 bg-slate-900/70 transition-all duration-300 hover:-translate-y-1 hover:border-lime-400/40 hover:shadow-[0_12px_30px_-10px_rgba(0,0,0,0.8),0_0_20px_rgba(132,204,22,0.08)]"
        >
          <div class="relative aspect-video w-full overflow-hidden bg-slate-950">
            {data.image ? (
              <img
                src={data.image}
                alt={data.title}
                class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            ) : (
              <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-slate-900 via-slate-950 to-emerald-950/80">
                <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle, #84cc16 1px, transparent 1px); background-size: 16px 16px;"></div>
                <svg class="h-12 w-12 text-lime-400/35 transition-colors group-hover:text-lime-400/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="4" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" />
                </svg>
              </div>
            )}
            <span class={`absolute left-3 top-3 z-10 rounded-md bg-gradient-to-r px-2.5 py-1 text-[10px] font-black uppercase tracking-wider shadow-lg ${categoryColors[data.category]}`}>
              {t[data.category]}
            </span>
          </div>

          <div class="flex flex-1 flex-col p-5">
            <time class="text-xs font-medium text-slate-500" datetime={data.pubDate.toISOString()}>
              {data.pubDate.toLocaleDateString(lang, { dateStyle: 'medium', timeZone: 'UTC' })}
            </time>
            <h3 class="mt-2 text-lg font-bold leading-snug text-white transition-colors group-hover:text-lime-400 line-clamp-2">
              <a href={`/${id}/`} class="after:absolute after:inset-0">
                {data.title}
              </a>
            </h3>
            <p class="mt-2 flex-grow text-sm text-slate-400 line-clamp-2">{data.description}</p>
            <div class="mt-4 flex items-center justify-between border-t border-slate-800/70 pt-4">
              <div class="flex max-h-5 flex-wrap gap-1.5 overflow-hidden">
                {data.tags.slice(0, 2).map(tag => (
                  <span class="rounded bg-slate-800/90 px-2 py-0.5 text-[10px] font-medium text-slate-400">#{tag}</span>
                ))}
              </div>
              <span class="inline-flex flex-shrink-0 items-center gap-1 text-xs font-bold text-lime-400">
                {ui.read} &rarr;
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.post-card');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        buttons.forEach(b => {
          b.className = 'filter-btn rounded-lg border border-slate-800 bg-slate-900 px-3 py-1.5 text-xs font-bold text-slate-300 transition-colors hover:border-lime-400/50 hover:text-white cursor-pointer';
        });
        btn.className = 'filter-btn rounded-lg bg-lime-400 px-3 py-1.5 text-xs font-bold text-slate-950 transition-colors cursor-pointer';
        cards.forEach(card => {
          const cat = card.getAttribute('data-category');
          (card as HTMLElement).style.display = (filter === 'all' || cat === filter) ? '' : 'none';
        });
      });
    });
  </script>
</Base>
