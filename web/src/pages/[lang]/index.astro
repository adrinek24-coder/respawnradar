---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { languages, text } from '../../i18n';

export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const { lang } = Astro.params;
const t = text[lang];
const posts = (await getCollection('posts', ({data}) => data.lang === lang)).sort((a,b) => +b.data.pubDate - +a.data.pubDate);
const alternates = { de: '/de/', en: '/en/', pl: '/pl/' };
---
<Base {lang} title={`RespawnRadar | ${t.headline}`} description={t.intro} {alternates}>
  <section class="panel bg-linear-to-br from-lime-950/65 via-slate-900 to-slate-950 py-12 sm:py-20">
    <h1 class="text-5xl font-black tracking-tight sm:text-7xl">{t.headline}</h1>
    <p class="mt-4 max-w-xl text-lg text-slate-300">{t.intro}</p>
  </section>
  <AdSlot {lang} placement="top" />
  <section class="mt-10">
    <h2 class="mb-5 text-2xl font-bold">{t.latest}</h2>
    <div class="grid gap-5 sm:grid-cols-2">
      {posts.map(({ id, data }) => <article class="panel">
        <p class="eyebrow">{t[data.category]}</p>
        <h3 class="mt-3 text-xl font-bold"><a href={`/${id}/`}>{data.title}</a></h3>
        <p class="mt-2 text-slate-300">{data.description}</p>
        <time class="mt-4 block text-sm text-slate-400" datetime={data.pubDate.toISOString()}>{data.pubDate.toLocaleDateString(lang, {dateStyle:'medium', timeZone:'UTC'})}</time>
      </article>)}
    </div>
  </section>
</Base>
