---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { languages, text } from '../../i18n';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = text[lang];
const posts = (await getCollection('posts', ({ data }) => data.lang === lang))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const alternates = { de: '/de/', en: '/en/', pl: '/pl/' };

const getThumb = (data: { image?: string; videoId?: string }) =>
  data.videoId ? `https://i.ytimg.com/vi/${data.videoId}/maxresdefault.jpg` : data.image;

const getFallback = (data: { videoId?: string }) =>
  data.videoId ? `https://i.ytimg.com/vi/${data.videoId}/hqdefault.jpg` : '';

const [heroMain, heroSide1, heroSide2, ...feedPosts] = posts;
const heroSides = [heroSide1, heroSide2].filter(Boolean);

const ui = {
  de: { latest: 'NEUESTE GUIDES', all: 'Alle', video: 'VIDEO' },
  en: { latest: 'LATEST FEED', all: 'All', video: 'VIDEO' },
  pl: { latest: 'NAJNOWSZE', all: 'Wszystkie', video: 'WIDEO' },
}[lang];

const catBadge = {
  game: 'bg-lime-400 text-black',
  hardware: 'bg-cyan-400 text-black',
  deals: 'bg-amber-400 text-black',
};
---

<Base {lang} title={`RespawnPing | ${t.headline}`} description={t.intro} {alternates}>
  {/* Editorial Magazine Bento Hero (3 Latest Stories) */}
  {heroMain && (
    <section class="grid gap-3 lg:grid-cols-12">
      {/* Main Lead Story (Left - 8 cols) */}
      <article class="group relative min-h-[340px] overflow-hidden rounded-xl bg-zinc-900 sm:min-h-[440px] lg:col-span-8">
        {getThumb(heroMain.data) ? (
          <img
            src={getThumb(heroMain.data)}
            data-fallback={getFallback(heroMain.data)}
            onerror="if(this.dataset.fallback && this.src !== this.dataset.fallback){this.src = this.dataset.fallback;}"
            onload="if(this.naturalWidth === 120 && this.dataset.fallback){this.src = this.dataset.fallback;}"
            alt={heroMain.data.title}
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
        ) : (
          <div class="absolute inset-0 bg-gradient-to-br from-zinc-800 via-zinc-900 to-black"></div>
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/55 to-transparent"></div>

        <div class="relative flex h-full flex-col justify-end p-6 sm:p-8">
          <div class="mb-3 flex items-center gap-2">
            <span class={`px-2 py-0.5 text-[11px] font-black uppercase tracking-wider ${catBadge[heroMain.data.category]}`}>
              {t[heroMain.data.category]}
            </span>
            {heroMain.data.videoId && (
              <span class="inline-flex items-center gap-1 bg-red-600 px-2 py-0.5 text-[11px] font-black uppercase tracking-wider text-white">
                <svg class="h-2.5 w-2.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><polygon points="6,4 20,12 6,20" /></svg>
                {ui.video}
              </span>
            )}
          </div>
          <h1 class="max-w-2xl text-2xl font-black leading-tight tracking-tight text-white transition-colors group-hover:text-lime-400 sm:text-4xl">
            <a href={`/${heroMain.id}/`} class="after:absolute after:inset-0">
              {heroMain.data.title}
            </a>
          </h1>
          <p class="mt-2.5 hidden max-w-xl text-sm text-zinc-300 line-clamp-2 sm:block">
            {heroMain.data.description}
          </p>
        </div>
      </article>

      {/* Secondary Stacked Stories (Right - 4 cols) */}
      <div class="grid gap-3 sm:grid-cols-2 lg:col-span-4 lg:grid-cols-1">
        {heroSides.map(post => {
          const thumb = getThumb(post.data);
          const fallback = getFallback(post.data);
          return (
            <article class="group relative min-h-[205px] overflow-hidden rounded-xl bg-zinc-900">
              {thumb ? (
                <img
                  src={thumb}
                  data-fallback={fallback}
                  onerror="if(this.dataset.fallback && this.src !== this.dataset.fallback){this.src = this.dataset.fallback;}"
                  onload="if(this.naturalWidth === 120 && this.dataset.fallback){this.src = this.dataset.fallback;}"
                  alt={post.data.title}
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              ) : (
                <div class="absolute inset-0 bg-gradient-to-br from-zinc-800 via-zinc-900 to-black"></div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent"></div>

              <div class="relative flex h-full flex-col justify-end p-5">
                <div class="mb-2 flex items-center gap-2">
                  <span class={`px-2 py-0.5 text-[10px] font-black uppercase tracking-wider ${catBadge[post.data.category]}`}>
                    {t[post.data.category]}
                  </span>
                  {post.data.videoId && (
                    <span class="inline-flex items-center justify-center bg-red-600 px-1.5 py-1 text-white" aria-label={ui.video}>
                      <svg class="h-2.5 w-2.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><polygon points="6,4 20,12 6,20" /></svg>
                    </span>
                  )}
                </div>
                <h2 class="text-lg font-extrabold leading-snug text-white transition-colors group-hover:text-lime-400 line-clamp-2">
                  <a href={`/${post.id}/`} class="after:absolute after:inset-0">
                    {post.data.title}
                  </a>
                </h2>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )}

  <div class="my-8">
    <AdSlot {lang} placement="top" />
  </div>

  {/* Clean Editorial Feed */}
  <section class="mt-10">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4 border-b-2 border-zinc-800 pb-3">
      <div class="flex items-center gap-3">
        <span class="h-5 w-1.5 bg-lime-400"></span>
        <h2 class="text-xl font-black uppercase tracking-tight text-white">{ui.latest}</h2>
      </div>

      <div class="flex flex-wrap gap-2" id="category-filters">
        <button data-filter="all" class="filter-btn cursor-pointer border-b-2 border-lime-400 px-2 py-1 text-xs font-black uppercase tracking-wider text-white">
          {ui.all}
        </button>
        {(['game', 'hardware', 'deals'] as const).map(cat => (
          <button data-filter={cat} class="filter-btn cursor-pointer border-b-2 border-transparent px-2 py-1 text-xs font-bold uppercase tracking-wider text-zinc-400 transition-colors hover:text-white">
            {t[cat]}
          </button>
        ))}
      </div>
    </div>

    <div class="divide-y divide-zinc-800/80">
      {feedPosts.map(({ id, data }) => {
        const thumb = getThumb(data);
        const fallback = getFallback(data);
        return (
          <article
            data-category={data.category}
            class="post-card group relative grid gap-5 py-6 sm:grid-cols-12 sm:items-center"
          >
            {/* Left Thumbnail */}
            <div class="relative aspect-video overflow-hidden rounded-lg bg-zinc-900 sm:col-span-4">
              {thumb ? (
                <img
                  src={thumb}
                  data-fallback={fallback}
                  onerror="if(this.dataset.fallback && this.src !== this.dataset.fallback){this.src = this.dataset.fallback;}"
                  onload="if(this.naturalWidth === 120 && this.dataset.fallback){this.src = this.dataset.fallback;}"
                  alt={data.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-zinc-800 to-zinc-950">
                  <span class="text-xs font-black uppercase tracking-widest text-zinc-600">RespawnPing</span>
                </div>
              )}
              {data.videoId && (
                <span class="absolute bottom-2 right-2 inline-flex items-center gap-1 rounded bg-black/80 px-2 py-0.5 text-[10px] font-black text-lime-400 backdrop-blur-sm">
                  <svg class="h-2.5 w-2.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><polygon points="6,4 20,12 6,20" /></svg>
                  {ui.video}
                </span>
              )}
            </div>

            {/* Right Editorial Text */}
            <div class="sm:col-span-8">
              <div class="flex items-center gap-3 text-xs font-bold uppercase tracking-wider">
                <span class="text-lime-400">{t[data.category]}</span>
                <span class="text-zinc-600">/</span>
                <time class="text-zinc-500" datetime={data.pubDate.toISOString()}>
                  {data.pubDate.toLocaleDateString(lang, { dateStyle: 'medium', timeZone: 'UTC' })}
                </time>
              </div>

              <h3 class="mt-2 text-xl font-black leading-snug text-white transition-colors group-hover:text-lime-400 sm:text-2xl">
                <a href={`/${id}/`} class="after:absolute after:inset-0">
                  {data.title}
                </a>
              </h3>

              <p class="mt-2 text-sm leading-relaxed text-zinc-400 line-clamp-2">
                {data.description}
              </p>

              <div class="mt-3 flex flex-wrap gap-2">
                {data.tags.slice(0, 3).map(tag => (
                  <span class="text-[11px] font-semibold text-zinc-500">#{tag}</span>
                ))}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.post-card');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        buttons.forEach(b => {
          b.className = 'filter-btn cursor-pointer border-b-2 border-transparent px-2 py-1 text-xs font-bold uppercase tracking-wider text-zinc-400 transition-colors hover:text-white';
        });
        btn.className = 'filter-btn cursor-pointer border-b-2 border-lime-400 px-2 py-1 text-xs font-black uppercase tracking-wider text-white';
        cards.forEach(card => {
          const cat = card.getAttribute('data-category');
          (card as HTMLElement).style.display = (filter === 'all' || cat === filter) ? '' : 'none';
        });
      });
    });
  </script>
</Base>
