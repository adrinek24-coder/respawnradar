---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { languages, names } from '../i18n';

const allPosts = await getCollection('posts');
const latestPosts = allPosts
  .filter(post => post.data.lang === 'en')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const alternates = { de: '/de/', en: '/en/', pl: '/pl/' };

const getThumb = (data: { image?: string; videoId?: string }) =>
  data.videoId ? `https://i.ytimg.com/vi/${data.videoId}/hqdefault.jpg` : data.image;

const categoryLabels = {
  game: { label: 'GUIDE', color: 'bg-lime-400 text-black' },
  hardware: { label: 'HARDWARE', color: 'bg-cyan-400 text-black' },
  deals: { label: 'DEALS', color: 'bg-amber-400 text-black' }
};
---

<Base lang="en" title="RespawnPing | Gaming Guides, Money Methods & Glitches" description="Your ultimate waypoint for gaming walkthroughs, secrets, fast cash methods, and hardware tips in English, Deutsch, and Polski." {alternates}>
  <section class="my-6">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4 border-b-2 border-zinc-800 pb-3">
      <div class="flex items-center gap-3">
        <span class="h-5 w-1.5 bg-lime-400"></span>
        <h1 class="text-xl font-black uppercase tracking-tight text-white">Latest Guides</h1>
      </div>
      <div class="flex flex-wrap gap-2">
        {languages.map(lang => (
          <a
            href={alternates[lang]}
            lang={lang}
            class="rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-1 text-xs font-bold text-zinc-300 transition-colors hover:border-lime-400 hover:text-white"
          >
            {names[lang]}
          </a>
        ))}
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {latestPosts.map(post => {
        const cat = categoryLabels[post.data.category] || categoryLabels.game;
        const postUrl = `/${post.id}/`;
        const thumb = getThumb(post.data);
        const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
          month: 'short',
          day: 'numeric',
          year: 'numeric'
        });

        return (
          <article class="group relative flex flex-col overflow-hidden rounded-xl border border-zinc-800/90 bg-zinc-900/60 transition-all hover:border-lime-400/50">
            <div class="relative aspect-video w-full overflow-hidden bg-zinc-950">
              {thumb ? (
                <img
                  src={thumb}
                  alt={post.data.title}
                  class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-zinc-800 to-zinc-950">
                  <span class="text-xs font-black uppercase tracking-widest text-zinc-600">RespawnPing</span>
                </div>
              )}

              <span class={`absolute left-3 top-3 z-10 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider ${cat.color}`}>
                {cat.label}
              </span>

              {post.data.videoId && (
                <span class="absolute bottom-2 right-2 rounded bg-black/80 px-2 py-0.5 text-[10px] font-black text-lime-400">
                  ▶ VIDEO
                </span>
              )}
            </div>

            <div class="flex flex-1 flex-col p-5">
              <span class="text-xs font-medium text-zinc-500">{formattedDate}</span>
              <h2 class="mt-2 text-lg font-bold leading-snug text-white transition-colors group-hover:text-lime-400 line-clamp-2">
                <a href={postUrl} class="after:absolute after:inset-0">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 flex-grow text-sm text-zinc-400 line-clamp-2">
                {post.data.description}
              </p>
              <div class="mt-4 flex items-center justify-between border-t border-zinc-800/70 pt-3">
                <div class="flex max-h-5 flex-wrap gap-1.5 overflow-hidden">
                  {post.data.tags.slice(0, 2).map(tag => (
                    <span class="text-[11px] font-semibold text-zinc-500">#{tag}</span>
                  ))}
                </div>
                <span class="text-xs font-bold text-lime-400">Read &rarr;</span>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Base>
