---
import { languages, names, legalPages, text, type Lang } from '../i18n';
import '../style.css';

const { lang, title, description, article = false, alternates, noindex = false } = Astro.props as {
  lang: Lang; title: string; description: string; article?: boolean;
  alternates?: Partial<Record<Lang, string>>; noindex?: boolean;
};
const t = text[lang];
const canonical = new URL(Astro.url.pathname, Astro.site!);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical.href} />
    {languages.map(code => alternates?.[code] && <link rel="alternate" hreflang={code} href={new URL(alternates[code]!, Astro.site).href} />)}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="RespawnPing" />
    <slot name="head" />
  </head>
  <body class="bg-[#09090b] text-zinc-100 antialiased selection:bg-lime-400 selection:text-black">
    <header class="sticky top-0 z-50 border-b border-zinc-800/80 bg-[#09090b]/90 backdrop-blur-md">
      <div class="shell flex items-center justify-between gap-4 py-3.5">
        {/* Custom Brand Logo Mark + Wordmark */}
        <a class="group inline-flex items-center gap-3" href={`/${lang}/`}>
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-lime-400 text-black shadow-[0_0_20px_rgba(163,230,53,0.35)] transition-transform group-hover:scale-105">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a10 10 0 1 0 10 10" />
              <path d="M12 6a6 6 0 1 0 6 6" />
              <polygon points="13 11 21 3 16 14 13 11" fill="currentColor" stroke="none" />
            </svg>
          </span>
          <span class="text-xl font-black uppercase tracking-tighter text-white">
            Respawn<span class="text-lime-400">Ping</span>
          </span>
        </a>

        {/* Language Switcher */}
        <nav class="flex items-center gap-1 text-xs font-bold uppercase tracking-wider" aria-label={{ de: 'Sprache', en: 'Language', pl: 'Język' }[lang]}>
          {languages.map(code => (
            <a
              href={alternates?.[code] ?? `/${code}/`}
              lang={code}
              hreflang={code}
              aria-current={lang === code ? 'true' : undefined}
              class={`px-2.5 py-1.5 transition-colors ${
                lang === code
                  ? 'border-b-2 border-lime-400 text-white'
                  : 'text-zinc-400 hover:text-white'
              }`}
            >
              {code}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="shell grow py-6 sm:py-8"><slot /></main>

    <footer class="mt-16 border-t border-zinc-800/80 bg-[#050507] py-10 text-sm text-zinc-400">
      <div class="shell flex flex-wrap items-center justify-between gap-6">
        <div class="flex items-center gap-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-lime-400"></span>
          <span class="font-black uppercase tracking-tight text-white">Respawn<span class="text-lime-400">Ping</span></span>
          <span class="text-zinc-600">&copy; {new Date().getUTCFullYear()}</span>
        </div>
        <nav class="flex flex-wrap gap-x-6 gap-y-2 text-xs font-semibold uppercase tracking-wider">
          {legalPages.filter(page => page !== 'impressum' || lang === 'de').map(page => (
            <a class="transition-colors hover:text-lime-400" href={`/${lang}/${page}/`}>{t[page]}</a>
          ))}
        </nav>
      </div>
    </footer>
  </body>
</html>
