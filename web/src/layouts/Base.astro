---
import '../style.css';
import { languages, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternates?: Partial<Record<Lang, string>>;
  noindex?: boolean;
}

const { lang, title, description, alternates = {}, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://respawnping.com').href;

const footerLinks: Record<Lang, { href: string; label: string }[]> = {
  en: [
    { href: '/en/privacy/', label: 'Privacy Policy' },
    { href: '/en/terms/', label: 'Terms of Use' },
    { href: '/en/about/', label: 'About' },
    { href: '/en/contact/', label: 'Contact' },
  ],
  pl: [
    { href: '/pl/privacy/', label: 'Polityka prywatności' },
    { href: '/pl/terms/', label: 'Warunki korzystania' },
    { href: '/pl/about/', label: 'O nas' },
    { href: '/pl/contact/', label: 'Kontakt' },
  ],
  de: [
    { href: '/de/privacy/', label: 'Datenschutz' },
    { href: '/de/terms/', label: 'Nutzungsbedingungen' },
    { href: '/de/about/', label: 'Über uns' },
    { href: '/de/contact/', label: 'Kontakt' },
    { href: '/de/impressum/', label: 'Impressum' },
  ],
};
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    {Object.entries(alternates).map(([code, path]) => (
      <link rel="alternate" hreflang={code} href={new URL(path, Astro.site || 'https://respawnping.com').href} />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="RespawnPing" />
  </head>

  <body class="flex min-h-screen flex-col bg-[#09090b] text-zinc-100 antialiased selection:bg-lime-400 selection:text-black">
    {/* Header */}
    <header class="sticky top-0 z-50 border-b border-zinc-800/80 bg-[#09090b]/90 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href={`/${lang}/`} class="group flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-lime-400 text-black shadow-lg shadow-lime-400/20 transition-transform group-hover:scale-105">
            <svg class="h-5 w-5" viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <circle cx="32" cy="32" r="20" stroke="currentColor" stroke-width="6" stroke-dasharray="90 30" stroke-linecap="round" />
              <circle cx="32" cy="32" r="11" stroke="currentColor" stroke-width="5" stroke-dasharray="44 22" stroke-linecap="round" />
              <circle cx="32" cy="32" r="4.5" fill="currentColor" />
              <line x1="32" y1="32" x2="47" y2="17" stroke="currentColor" stroke-width="5.5" stroke-linecap="round" />
            </svg>
          </span>
          <span class="text-lg font-black tracking-tight text-white sm:text-xl">
            RESPAWN<span class="text-lime-400">PING</span>
          </span>
        </a>

        <nav class="flex items-center gap-4 text-xs font-bold uppercase tracking-wider" aria-label="Language">
          {languages.map(code => {
            const href = alternates[code] || `/${code}/`;
            const isActive = code === lang;
            return (
              <a
                href={href}
                lang={code}
                class={
                  isActive
                    ? 'border-b-2 border-lime-400 pb-1 text-white'
                    : 'pb-1 text-zinc-400 transition-colors hover:text-white'
                }
              >
                {code}
              </a>
            );
          })}
        </nav>
      </div>
    </header>

    {/* Main Content */}
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-6">
      <slot />
    </main>

    {/* Footer */}
    <footer class="mt-16 border-t border-zinc-800/80 bg-[#09090b]">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div class="flex items-center gap-2 text-xs font-black uppercase tracking-wider text-zinc-400">
          <span class="h-2.5 w-2.5 rounded-full bg-lime-400"></span>
          <span>RESPAWNPING &copy; 2026</span>
        </div>

        <nav class="flex flex-wrap gap-x-6 gap-y-2 text-xs font-bold uppercase tracking-wider text-zinc-400">
          {footerLinks[lang].map(link => (
            <a href={link.href} class="transition-colors hover:text-lime-400">
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </footer>
  </body>
</html>
