---
import { languages, names, legalPages, text, type Lang } from '../i18n';
import '../style.css';

const { lang, title, description, article = false, alternates, noindex = false } = Astro.props as {
  lang: Lang; title: string; description: string; article?: boolean;
  alternates?: Partial<Record<Lang, string>>; noindex?: boolean;
};
const t = text[lang];
const canonical = new URL(Astro.url.pathname, Astro.site!);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical.href} />
    {languages.map(code => alternates?.[code] && <link rel="alternate" hreflang={code} href={new URL(alternates[code]!, Astro.site).href} />)}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="RespawnPing" />
    <slot name="head" />
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased">
    <header class="sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950/85 backdrop-blur-md">
      <div class="shell flex flex-wrap items-center justify-between gap-4 py-4">
        <a class="brand inline-flex items-center gap-2.5 text-xl font-black tracking-tight text-white" href={`/${lang}/`}>
          <span class="relative flex h-3 w-3">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-lime-400 opacity-75"></span>
            <span class="relative inline-flex h-3 w-3 rounded-full bg-lime-400"></span>
          </span>
          <span>Respawn<span class="text-lime-400">Ping</span></span>
        </a>
        <nav class="flex items-center gap-1.5 rounded-xl border border-slate-800 bg-slate-900/80 p-1 text-xs font-bold" aria-label={{ de: 'Sprache', en: 'Language', pl: 'Język' }[lang]}>
          {languages.map(code => (
            <a
              href={alternates?.[code] ?? `/${code}/`}
              lang={code}
              hreflang={code}
              aria-current={lang === code ? 'true' : undefined}
              class={`rounded-lg px-3 py-1.5 transition-all ${
                lang === code
                  ? 'bg-lime-400 text-slate-950 shadow-sm'
                  : 'text-slate-300 hover:bg-slate-800 hover:text-white'
              }`}
            >
              {names[code]}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main class="shell grow py-8 sm:py-10"><slot /></main>
    <footer class="mt-12 border-t border-slate-800/80 bg-slate-950 py-8 text-sm text-slate-400">
      <div class="shell flex flex-wrap items-center justify-between gap-4">
        <span class="font-bold text-slate-300">Respawn<span class="text-lime-400">Ping</span> &copy; {new Date().getUTCFullYear()}</span>
        <nav class="flex flex-wrap gap-x-5 gap-y-2">
          {legalPages.filter(page => page !== 'impressum' || lang === 'de').map(page => (
            <a class="transition-colors hover:text-lime-400" href={`/${lang}/${page}/`}>{t[page]}</a>
          ))}
        </nav>
      </div>
    </footer>
  </body>
</html>
